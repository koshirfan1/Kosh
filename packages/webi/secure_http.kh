# webi/secure_http.kh — plugs the encrypted channel (secure.kh) into the
# webi HTTP server (v1.2.0, milestone M2).
#
# Enable it on an app:
#
#   app = webi_enable_secure(app, {})            # defaults
#   app = webi_enable_secure(app, {"max_sessions": 500, "ttl": 1800})
#   app = webi_enable_secure(app, {"require_secure": true, "public": ["/", "/static/", "/robots.txt"]})
#
# With "require_secure": true every plain (non-channel) request is refused
# with 426 Upgrade Required, except paths listed in "public" (an entry ending
# in "/" matches that prefix - except "/" itself, which is the home page only -
# anything else matches exactly) - this is what
# keeps SEO pages, link previews and uptime checks working. Public routes are
# served in the clear, so never put anything private on them.
#
# Search engines: a page that should be indexable but not readable by
# everyone goes in "bot_paths" instead of "public":
#
#   app = webi_enable_secure(app, {"require_secure": true, "bot_paths": ["/blog/"]})
#
# A request for a bot path is served in the clear ONLY if it comes from a
# verified crawler (forward-confirmed reverse DNS, see bot.kh) - a User-Agent
# claim alone never counts. Everyone else gets 426 and must use the channel.
# Verified crawlers get nothing else: a private route stays encrypted for them
# too. The handler sees req["verified_bot"] (e.g. "googlebot"), and the
# response is marked Cache-Control: private, no-store so a CDN cannot keep a
# plain copy and hand it to others. Extra options: "bots" (names to allow;
# default googlebot, bingbot, applebot, yandexbot, baiduspider), "extra_bots"
# ({name: {"uas": [...], "suffixes": [".example.com"]}}) and
# "bot_lookups_per_min" (20).
#
# Proof page (opt-in, "proof": true): GET /_webi/proof is a live self-check
# that runs real tests in the visitor's browser (handshake, authenticated round
# trip, wire opacity, replay and tamper rejection, plain-access policy) and
# GET /_webi/proof.json publishes the configuration and counters. It states
# plainly what it does NOT prove (no external review has been done). The
# optional badge is just a link to that page: webi_badge_html().
#
# Browsers: GET /_webi/client.js serves the JavaScript client (always in the
# clear, it is public code). With "bootstrap": true, a browser navigation
# (GET with Accept: text/html) to a protected path gets a tiny shell page
# instead of 426; the shell loads the client, which fetches the real page
# through the channel and replaces the document with it. The shell reveals
# nothing but the URL the browser already knows, is never cached, and carries
# X-Robots-Tag: noindex. API clients (no text/html in Accept) still get 426.
#
# That adds two endpoints, handled BEFORE the app's middlewares:
#
#   POST /_webi/handshake   body: {"v":1,"pub":"<64 hex>"}
#                           -> {"v":1,"sid":"<32 hex>","pub":"<64 hex>"}
#   POST /_webi/secure      body: a sealed packet (see secure.kh)
#                           -> a sealed packet (always HTTP 200)
#
# The sealed request carries the real request:
#   {"method","path","query","headers","body"}
# The server unseals it and runs it through webi_handle() exactly like a
# normal request, so every middleware (CSRF, API keys, rate limiting, CORS,
# ...) and every route handler applies to it unchanged. The real response
# {"status","content_type","headers","cookies","body"} is sealed on the way
# back. Anything watching the wire - or a TLS-terminating proxy - sees only
# POST /_webi/secure with opaque bytes both ways, and an outer status of 200
# regardless of the inner result.
#
# Anything that goes wrong BEFORE a packet authenticates (unknown session,
# replay, bad tag, malformed) gets the same bare 403, so the endpoint is not
# an oracle for which check failed.
#
# Limits (documented, not hidden):
#   * Text bodies only - the inner message is JSON.
#   * Runs on top of TLS (see docs/webi-threat-model.md); the handshake is
#     not authenticated by itself.
#   * Per-IP rate limits on both endpoints use the native rate limiter
#     (4096-key table; expired entries are reused and, under a flood of
#     live keys, low-count entries are evicted - see rate_limit_check()).
#     Counters live in process memory: a restart resets them, and they are
#     not shared between server processes.
#   * The /_webi/ prefix is reserved and cannot be requested through the
#     channel (no nesting).
#
# Client helpers (for Kosh clients and tests):
#   wsec_client_hello_body(client)                         -> JSON string
#   wsec_client_request(sess, method, path, query, headers, body) -> packet
#   wsec_client_read_response(sess, packet)                -> res map | nil

let WSEC_AAD_REQ = "webi-req"
let WSEC_AAD_RES = "webi-res"
let WSEC_HTTP_METHODS = ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]

# ---------------------------------------------------------------------------
# enabling
# ---------------------------------------------------------------------------

# opts keys (all optional): max_sessions (1000), ttl seconds (3600),
# handshake_per_min (30 per client IP), requests_per_min (1200 per client IP),
# require_secure (false), public (array of paths served in the clear)
fn webi_enable_secure(app, opts):
    let max_sessions = 1000
    let ttl = 3600
    let hs = 30
    let rq = 1200
    let require = false
    let public_paths = []
    let bot_paths = []
    let bot_names = nil
    let bot_extra = nil
    let bot_budget = 20
    let bootstrap = false
    let proof = false
    if type(opts) == "map":
        if has(opts, "require_secure"):
            require = opts["require_secure"] == true
        if has(opts, "public") and type(opts["public"]) == "array":
            public_paths = opts["public"]
        if has(opts, "bot_paths") and type(opts["bot_paths"]) == "array":
            bot_paths = opts["bot_paths"]
        if has(opts, "bots") and type(opts["bots"]) == "array":
            bot_names = opts["bots"]
        if has(opts, "extra_bots") and type(opts["extra_bots"]) == "map":
            bot_extra = opts["extra_bots"]
        if has(opts, "bot_lookups_per_min"):
            bot_budget = opts["bot_lookups_per_min"]
        if has(opts, "bootstrap"):
            bootstrap = opts["bootstrap"] == true
        if has(opts, "proof"):
            proof = opts["proof"] == true
        if has(opts, "max_sessions"):
            max_sessions = opts["max_sessions"]
        if has(opts, "ttl"):
            ttl = opts["ttl"]
        if has(opts, "handshake_per_min"):
            hs = opts["handshake_per_min"]
        if has(opts, "requests_per_min"):
            rq = opts["requests_per_min"]
    let store = wsec_new_store(max_sessions, ttl)
    store["hs_limit"] = hs
    store["req_limit"] = rq
    store["require"] = require
    store["public"] = public_paths
    store["bot_paths"] = bot_paths
    store["bootstrap"] = bootstrap
    store["proof"] = proof
    store["started"] = timestamp()
    store["stats"] = {
        "handshakes_ok": 0, "handshakes_refused": 0,
        "secure_requests_ok": 0, "secure_requests_rejected": 0,
        "plain_requests_refused": 0, "rate_limited": 0,
        "crawlers_verified": 0, "shells_served": 0
    }
    store["bot"] = wbot_new(bot_names, bot_extra, bot_budget)
    store["_inside"] = false
    app["_secure"] = store
    if proof:
        app = route(app, "GET", WSEC_PROBE_PATH, _wsec_probe)
    return app

# Counter bump (counters feed /_webi/proof.json only).
fn _wsec_stat(store, key):
    store["stats"][key] = store["stats"][key] + 1

# ---------------------------------------------------------------------------
# proof page (opt-in)
# ---------------------------------------------------------------------------

let WSEC_PROBE_PATH = "/.well-known/webi-proof"

# Echoes a nonce so the proof page can show an authenticated round trip.
fn _wsec_probe(req):
    let n = query_get(req, "n", "")
    if len(n) > 64:
        n = ""
    return res_json({"ok": true, "nonce": n})

let WSEC_PROOF_HTML = "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"noindex\"><title>Webi secure channel - live self-check</title><style>body{font:16px/1.5 system-ui,sans-serif;max-width:46rem;margin:2rem auto;padding:0 1rem;color:#1b1f23}h1{font-size:1.4rem}h2{font-size:1.1rem;margin-top:2rem}ul{list-style:none;padding:0}li{margin:.5rem 0;padding:.5rem .75rem;border-left:4px solid #999;background:#f6f8fa}li.pass{border-color:#1a7f37}li.fail{border-color:#cf222e;background:#fff0f0}li.warn{border-color:#9a6700;background:#fff8e1}li.info{border-color:#0969da}.tag{font:600 .75rem monospace;margin-right:.4rem}.detail{font-size:.85rem;color:#57606a;word-break:break-all}dl{display:grid;grid-template-columns:max-content 1fr;gap:.2rem 1rem}dt{color:#57606a}dd{margin:0}#summary{font-weight:700;padding:.5rem .75rem;background:#eee}#summary.good{background:#dafbe1}#summary.bad{background:#ffebe9}#summary.meh{background:#fff8c5}.limits li{border-color:#999}</style></head><body><h1>Webi secure channel: live self-check</h1><p>These checks run right now, in your browser, against this server, using the same client code applications use.</p><div id=\"summary\">Running checks...</div><ul id=\"checks\"></ul><h2>Server configuration</h2><dl id=\"facts\"></dl><h2>What this does not prove</h2><ul class=\"limits\"><li>That the server software is free of bugs. These checks test behaviour, not code.</li><li>That the protocol has been independently reviewed. It has not; see \"External cryptographic review\" above.</li><li>That your browser or network is trustworthy. Script running in this page (an extension, XSS) could read the keys.</li><li>That this page itself is genuine. A malicious server could serve a page that always says PASS. Compare the client hash with one you pinned elsewhere, and prefer your own tests.</li><li>That plain HTTP is safe: the channel assumes TLS.</li></ul><noscript>This page needs JavaScript.</noscript><script src=\"/_webi/client.js\"></script><script src=\"/_webi/proof.js\"></script></body></html>"

fn _wsec_proof_json(store):
    return {
        "protocol": "kosh-webi/1",
        "webi_version": "1.2.0",
        "primitives": {
            "kex": "X25519 (RFC 7748), ephemeral",
            "kdf": "HKDF-SHA256 (RFC 5869)",
            "aead": "ChaCha20-Poly1305 (RFC 8439)"
        },
        "replay_window": WSEC_WINDOW,
        "require_secure": store["require"],
        "bootstrap": store["bootstrap"],
        "bot_verification": len(store["bot_paths"]) > 0,
        "sessions_active": store["count"],
        "uptime_seconds": timestamp() - store["started"],
        "stats": store["stats"],
        "client_sha256": WEBI_CLIENT_JS_SHA256,
        "external_review": false,
        "runs_inside_tls_required": true
    }

fn _wsec_proof_res(path, store):
    if path == "/_webi/proof":
        let page = res_html(WSEC_PROOF_HTML)
        page = res_with_header(page, "Cache-Control", "no-store")
        page = res_with_header(page, "X-Content-Type-Options", "nosniff")
        return res_with_header(page, "Content-Security-Policy", "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'")
    if path == "/_webi/proof.js":
        let js = res_status(200, WEBI_PROOF_JS)
        js["content_type"] = "application/javascript; charset=utf-8"
        js = res_with_header(js, "Cache-Control", "public, max-age=300")
        js = res_with_header(js, "X-Content-Type-Options", "nosniff")
        return res_with_header(js, "X-Webi-Proof-SHA256", WEBI_PROOF_JS_SHA256)
    if path == "/_webi/proof.json":
        let j = res_json(_wsec_proof_json(store))
        return res_with_header(j, "Cache-Control", "no-store")
    return nil

# Optional badge: an ordinary link to the live self-check, NOT a claim.
fn webi_badge_html():
    return "<a href=\"/_webi/proof\" rel=\"noopener\">Webi secure channel: verify live</a>"

# ---------------------------------------------------------------------------
# server side
# ---------------------------------------------------------------------------

fn _wsec_plain_res(status, body):
    let res = res_status(status, body)
    return res_with_header(res, "Cache-Control", "no-store")

# True if `path` matches an entry of `list`: an entry ending in "/" is a
# prefix, except "/" alone which is the home page only (matching it as a
# prefix would match every path); anything else matches exactly.
fn _wsec_path_in(list, path):
    let i = 0
    while i < len(list):
        let e = list[i]
        if type(e) == "string" and len(e) > 0:
            if e != "/" and substring(e, len(e) - 1, 1) == "/":
                if len(path) >= len(e) and substring(path, 0, len(e)) == e:
                    return true
            else:
                if path == e:
                    return true
        i = i + 1
    return false

# Called by webi_handle() for requests that arrive OUTSIDE the channel when
# "require_secure" is on. Returns a 426 response, or nil to let it through.
fn _wsec_gate(app, req):
    let store = app["_secure"]
    if store == nil or store["require"] != true or store["_inside"] == true:
        return nil
    if _wsec_path_in(store["public"], req["path"]):
        return nil
    # Crawler exception: ONLY on a listed bot path, ONLY if verified.
    if _wsec_path_in(store["bot_paths"], req["path"]):
        let name = wbot_check_request(store["bot"], req)
        if name != nil:
            req["verified_bot"] = name
            _wsec_stat(store, "crawlers_verified")
            return nil
    if store["bootstrap"] == true and req["method"] == "GET":
        let accept = wbot_header(req, "accept")
        if type(accept) == "string" and contains(lower(accept), "text/html"):
            _wsec_stat(store, "shells_served")
            return _wsec_shell()
    _wsec_stat(store, "plain_requests_refused")
    return _wsec_plain_res(426, "Secure channel required")

# The page browsers get instead of 426 when "bootstrap" is on.
let WSEC_SHELL = "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"noindex\"><title>Loading</title></head><body><noscript>This page needs JavaScript to open a secure channel.</noscript><script src=\"/_webi/client.js\" data-webi-bootstrap></script></body></html>"

fn _wsec_shell():
    let res = res_html(WSEC_SHELL)
    res = res_with_header(res, "Cache-Control", "no-store")
    return res_with_header(res, "X-Robots-Tag", "noindex")

# Called by webi_handle() for paths under /_webi/. Returns a response map if
# it handled the request, nil if the path is not one of ours.
fn _wsec_handle(app, req):
    let store = app["_secure"]
    if store == nil:
        return nil
    if store["proof"] == true and (req["path"] == "/_webi/proof" or req["path"] == "/_webi/proof.js" or req["path"] == "/_webi/proof.json"):
        if req["method"] != "GET" and req["method"] != "HEAD":
            return _wsec_plain_res(405, "Method Not Allowed")
        if not rate_limit_check("wsec_js:" + req["ip"], store["req_limit"], 60):
            _wsec_stat(store, "rate_limited")
            return _wsec_plain_res(429, "Too Many Requests")
        return _wsec_proof_res(req["path"], store)
    if req["path"] == "/_webi/client.js":
        if req["method"] != "GET" and req["method"] != "HEAD":
            return _wsec_plain_res(405, "Method Not Allowed")
        if not rate_limit_check("wsec_js:" + req["ip"], store["req_limit"], 60):
            return _wsec_plain_res(429, "Too Many Requests")
        let js = res_status(200, WEBI_CLIENT_JS)
        js["content_type"] = "application/javascript; charset=utf-8"
        js = res_with_header(js, "Cache-Control", "public, max-age=300")
        js = res_with_header(js, "X-Content-Type-Options", "nosniff")
        return res_with_header(js, "X-Webi-Client-SHA256", WEBI_CLIENT_JS_SHA256)
    if req["path"] == "/_webi/handshake":
        if req["method"] != "POST":
            return _wsec_plain_res(405, "Method Not Allowed")
        if not rate_limit_check("wsec_hs:" + req["ip"], store["hs_limit"], 60):
            _wsec_stat(store, "rate_limited")
            return _wsec_plain_res(429, "Too Many Requests")
        return _wsec_http_handshake(store, req)
    if req["path"] == "/_webi/secure":
        if req["method"] != "POST":
            return _wsec_plain_res(405, "Method Not Allowed")
        if not rate_limit_check("wsec_rq:" + req["ip"], store["req_limit"], 60):
            _wsec_stat(store, "rate_limited")
            return _wsec_plain_res(429, "Too Many Requests")
        return _wsec_http_secure(app, store, req)
    return nil

fn _wsec_http_handshake(store, req):
    let reply = wsec_server_accept(store, req["body_json"])
    if reply == nil:
        _wsec_stat(store, "handshakes_refused")
        return _wsec_plain_res(400, "handshake rejected")
    _wsec_stat(store, "handshakes_ok")
    return res_with_header(res_json(reply), "Cache-Control", "no-store")

# The sealed inner request, validated. Returns a map of strings or nil.
fn _wsec_parse_inner(plain):
    let inner = json_decode(plain)
    if type(inner) != "map":
        return nil
    if not has(inner, "method") or not has(inner, "path"):
        return nil
    if type(inner["method"]) != "string" or type(inner["path"]) != "string":
        return nil
    let method = upper(inner["method"])
    if not contains_str_in_list(WSEC_HTTP_METHODS, method):
        return nil
    let path = inner["path"]
    if len(path) < 1 or len(path) > 2048 or substring(path, 0, 1) != "/":
        return nil
    if len(path) >= 7 and substring(path, 0, 7) == "/_webi/":
        return nil
    if path == "/_webi":
        return nil
    let query = ""
    if has(inner, "query"):
        if type(inner["query"]) != "string":
            return nil
        query = inner["query"]
    let headers = ""
    if has(inner, "headers"):
        if type(inner["headers"]) != "string":
            return nil
        headers = inner["headers"]
    let body = ""
    if has(inner, "body"):
        if type(inner["body"]) != "string":
            return nil
        body = inner["body"]
    return {"method": method, "path": path, "query": query, "headers": headers, "body": body}

fn _wsec_http_secure(app, store, req):
    let packet = req["body"]
    let p = wsec_parse(packet)
    if p == nil:
        _wsec_stat(store, "secure_requests_rejected")
        return _wsec_plain_res(403, "rejected")
    let plain = wsec_server_open(store, packet, WSEC_AAD_REQ)
    if plain == nil:
        _wsec_stat(store, "secure_requests_rejected")
        return _wsec_plain_res(403, "rejected")

    # From here on the packet is authentic, so errors get a proper sealed reply.
    let inner = _wsec_parse_inner(plain)
    let res = nil
    if inner == nil:
        res = res_bad_request("malformed secure request")
    else:
        # The nested request is already inside the channel: let it past the
        # require_secure gate (the server is single-threaded, so this flag
        # cannot leak into another request).
        store["_inside"] = true
        res = webi_handle(app, inner["method"], inner["path"], inner["query"], inner["headers"], inner["body"], req["ip"])
        store["_inside"] = false

    let out = json_encode({
        "status": res["status"],
        "content_type": res["content_type"],
        "headers": res["headers"],
        "cookies": res["cookies"],
        "body": res["body"]
    })
    let sealed = wsec_server_seal(store, p["sid"], WSEC_AAD_RES, out)
    if sealed == nil:
        return _wsec_plain_res(500, "could not seal response")
    _wsec_stat(store, "secure_requests_ok")
    return res_with_header(res_text(sealed), "Cache-Control", "no-store")

# ---------------------------------------------------------------------------
# client side
# ---------------------------------------------------------------------------

fn wsec_client_hello_body(client):
    return json_encode(wsec_client_hello(client))

# headers: map of string -> string (or nil).
fn wsec_client_request(sess, method, path, query, headers, body):
    let hs = ""
    if type(headers) == "map":
        for k in keys(headers):
            hs = hs + k + ": " + str(headers[k]) + "\n"
    let plain = json_encode({
        "method": method,
        "path": path,
        "query": query,
        "headers": hs,
        "body": body
    })
    return wsec_seal(sess, WSEC_AAD_REQ, plain)

# The body of the /_webi/secure HTTP response -> {"status","content_type",
# "headers","cookies","body"}, or nil if it does not authenticate.
fn wsec_client_read_response(sess, packet):
    let plain = wsec_open(sess, packet, WSEC_AAD_RES)
    if plain == nil:
        return nil
    let res = json_decode(plain)
    if type(res) != "map":
        return nil
    return res
