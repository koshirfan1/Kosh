# webi/template.kh — tiny string template renderer + HTML escaping.
# Depends on str_replace from util.kh.

# ---------------------------------------------------------------------------
# render(template, vars) -> string
#
# Fills {{key}} placeholders from the vars map, HTML-ESCAPING every value
# (& < > " ' become &amp; &lt; &gt; &quot; &#39;), so a value that comes from a
# user cannot inject markup or script:
#
#   let html = render("<h1>Hello, {{name}}!</h1>", {"name": "<script>alert(1)</script>"})
#   # <h1>Hello, &lt;script&gt;alert(1)&lt;/script&gt;!</h1>
#
# To insert HTML you built yourself (and know is safe), use THREE braces for
# that one placeholder:  {{{page_body}}}  inserts the value as-is.
#
# Rules:
#   * The template is scanned once; inserted values are never scanned again, so
#     a value containing "{{other}}" stays literal text.
#   * A placeholder whose key is not in vars is left exactly as written.
#   * Keys match exactly ("{{ name }}" with spaces is not a placeholder).
#   * Numbers, booleans and nil are converted with str() first.
#
# Escaping protects text between tags and quoted attribute values
# (<a title="{{t}}">). It does NOT make these safe, so never put {{...}} there:
# inside <script> or <style>, in an unquoted attribute, in an event-handler
# attribute (onclick="..."), or as the start of a URL (href="{{url}}" accepts
# "javascript:..."). Check URLs yourself before inserting them.
#
# (Before webi 1.4.0 render() did NOT escape. If you relied on that, use
# {{{key}}} for the placeholders that carry HTML, or render_raw() for the old
# behaviour of a whole template.)
# ---------------------------------------------------------------------------
fn render(template, vars):
    return _webi_render(template, vars)

# ---------------------------------------------------------------------------
# render_raw(template, vars) -> string
# Like render(), but {{key}} inserts the value WITHOUT escaping (the pre-1.4.0
# behaviour; still single-pass). Only for templates whose values are all
# trusted HTML. Prefer {{{key}}} on individual placeholders with render().
# ---------------------------------------------------------------------------
fn render_raw(template, vars):
    return _webi_render_raw(template, vars)

# ---------------------------------------------------------------------------
# Internal: does `path` end in a recognized template extension?
# Defined before render_file() below since this interpreter's closures
# snapshot the enclosing scope at declaration time (see AST_FN_DECL) — a
# function can only call helpers that were already defined earlier in
# the file.
# ---------------------------------------------------------------------------
fn _webi_has_template_ext(path):
    let allowed = [".html", ".htm", ".txt", ".xml", ".svg"]
    let i = 0
    while i < len(allowed):
        let ext = allowed[i]
        let elen = len(ext)
        if len(path) >= elen and substring(path, len(path) - elen, elen) == ext:
            return true
        i = i + 1
    return false

# ---------------------------------------------------------------------------
# render_file(path, vars) -> string | nil                       (v1.1.2)
# Same as render(), but reads the template off disk instead of taking a
# string literal directly.
#
#   let html = render_file("templates/index.html", {"name": "Irfan"})
#
# `path` is resolved directory-aware: relative to whichever .kh file is
# calling render_file() (same mechanism `import` already uses), not
# relative to whatever directory `kosh` happens to be run from. So this
# works the same whether you run `kosh app.kh` from the project root or
# from somewhere else entirely.
#
# Guards against the same class of bug as "GET /static/../../server.kh"
# in serve_static() below — `path` is meant to be something you write
# yourself, but if it's ever built from request input (e.g.
# "templates/" + req["query"]["page"] + ".html"), these stop that from
# turning into an arbitrary-file-read:
#   1. Containment — the resolved file must stay inside the directory
#      render_file() is called from. A ".." segment (raw or
#      percent-encoded), an absolute path, or a symlink pointing outside
#      it (POSIX) all get rejected, not just a literal ".." string check.
#   2. Extension allow-list — must look like a template
#      (.html/.htm/.txt/.xml/.svg). There's no legitimate reason for a
#      template renderer to be opening anything else.
#   3. Size cap (2 MB) — templates are meant to be small hand-written
#      files; this is a sanity backstop, not a real limit anyone should
#      ever hit.
#
# Returns nil on any rejection (and prints a warning) instead of raising
# — a broken template path shouldn't take the whole app down. Check for
# nil before using the result, e.g.:
#   let html = render_file("templates/index.html", vars)
#   if html == nil:
#       return res_server_error("template error")
#   return res_html(html)
# ---------------------------------------------------------------------------
fn _webi_read_template(path, who):
    let base_dir = _webi_script_dir()
    let safe_path = _webi_safe_static_path(base_dir, path)

    if safe_path == nil:
        print "[webi] " + who + ": rejected '" + path + "' (missing, or escapes its own directory)"
        return nil

    if not _webi_has_template_ext(safe_path):
        print "[webi] " + who + ": rejected '" + path + "' (not a recognized template extension: .html/.htm/.txt/.xml/.svg)"
        return nil

    let content = read_file(safe_path)

    if len(content) > 2000000:
        print "[webi] " + who + ": rejected '" + path + "' (file too large, over 2MB)"
        return nil
    return content

fn render_file(path, vars):
    let content = _webi_read_template(path, "render_file")
    if content == nil:
        return nil
    return render(content, vars)

# render_file() without escaping {{key}} (see render_raw()).
fn render_file_raw(path, vars):
    let content = _webi_read_template(path, "render_file_raw")
    if content == nil:
        return nil
    return render_raw(content, vars)

# ---------------------------------------------------------------------------
# html_escape(str) -> string
# Escape HTML special characters to prevent XSS
# ---------------------------------------------------------------------------
fn html_escape(s):
    s = str_replace(s, "&", "&amp;")
    s = str_replace(s, "<", "&lt;")
    s = str_replace(s, ">", "&gt;")
    s = str_replace(s, "\"", "&quot;")
    s = str_replace(s, "'", "&#39;")
    return s
