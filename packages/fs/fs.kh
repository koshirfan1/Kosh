# Kosh fs package v1.1.0
# Author: Irfan Khan
# File system utilities — read, write, append, copy, walk paths
#
# Usage:
#   import "fs"
#   let data = fs_read("config.json")
#   fs_write("out.txt", "hello")
#   fs_append("log.txt", "new line\n")

# ─────────────────────────────────────────────────────────────
# READ
# ─────────────────────────────────────────────────────────────

fn fs_read(path):
    return read_file(path)

fn fs_read_lines(path):
    let content = read_file(path)
    if content == nil:
        return nil
    return split(content, "\n")

fn fs_read_json(path):
    let content = read_file(path)
    if content == nil:
        return nil
    return json_decode(content)

# ─────────────────────────────────────────────────────────────
# WRITE
# ─────────────────────────────────────────────────────────────

fn fs_write(path, content):
    # Atomic: temp file + rename, so a crash never leaves a truncated file.
    # Returns bytes written, or nil on failure.
    return write_file_atomic(path, content)

fn fs_write_json(path, data):
    return write_file_atomic(path, json_encode(data))

fn fs_append(path, content):
    let existing = read_file(path)
    if existing == nil:
        existing = ""
    return write_file_atomic(path, existing + content)

fn fs_append_line(path, line):
    return fs_append(path, line + "\n")

# ─────────────────────────────────────────────────────────────
# CHECK
# ─────────────────────────────────────────────────────────────

fn fs_exists(path):
    return file_exists(path)

fn fs_is_empty(path):
    let content = read_file(path)
    if content == nil:
        return true
    return len(content) == 0

fn fs_size(path):
    let content = read_file(path)
    if content == nil:
        return 0
    return len(content)

# ─────────────────────────────────────────────────────────────
# PATH HELPERS
# ─────────────────────────────────────────────────────────────

fn fs_basename(path):
    let parts = split(path, "/")
    if len(parts) == 0:
        return path
    return parts[len(parts) - 1]

fn fs_dirname(path):
    let parts = split(path, "/")
    if len(parts) <= 1:
        return "."
    let result = ""
    let i = 0
    while i < len(parts) - 1:
        if i > 0:
            result = result + "/"
        result = result + parts[i]
        i = i + 1
    return result

fn fs_extname(path):
    let base = fs_basename(path)
    let parts = split(base, ".")
    if len(parts) <= 1:
        return ""
    return "." + parts[len(parts) - 1]

fn fs_stem(path):
    let base = fs_basename(path)
    let ext  = fs_extname(path)
    if len(ext) == 0:
        return base
    return substring(base, 0, len(base) - len(ext))

fn fs_join(a, b):
    if len(a) == 0:
        return b
    let last = substring(a, len(a) - 1, 1)
    if last == "/":
        return a + b
    return a + "/" + b

# ─────────────────────────────────────────────────────────────
# COPY / MOVE
# ─────────────────────────────────────────────────────────────

fn fs_copy(src, dst):
    let content = read_file(src)
    if content == nil:
        return false
    return write_file_atomic(dst, content)

# ─────────────────────────────────────────────────────────────
# CONFIG HELPERS  (read/write key-value JSON config)
# ─────────────────────────────────────────────────────────────

fn fs_config_read(path):
    let data = fs_read_json(path)
    if data == nil:
        return {}
    return data

fn fs_config_get(path, key, default_val):
    let cfg = fs_config_read(path)
    if has(cfg, key):
        return cfg[key]
    return default_val

fn fs_config_set(path, key, value):
    # Refuse to overwrite a config that exists but cannot be parsed:
    # silently replacing it with {} would destroy the user's data.
    let raw = read_file(path)
    if raw != nil and len(raw) > 0:
        if json_decode(raw) == nil:
            return nil
    let cfg = fs_config_read(path)
    cfg[key] = value
    return fs_write_json(path, cfg)

# ─────────────────────────────────────────────────────────────
# SANDBOX  (opt-in: confine all access to one directory)
# ─────────────────────────────────────────────────────────────
# The plain fs_* functions above accept ANY path, including "../x" and
# absolute paths. If a path can come from a user or another program,
# use the sandbox functions instead:
#
#   let sb = fs_sandbox("/srv/uploads")
#   fs_sandbox_write(sb, "a.txt", "hi")       # ok
#   fs_sandbox_write(sb, "../evil.txt", "x")  # nil: escapes the root
#   fs_sandbox_read(sb, "/etc/passwd")        # nil: absolute path
#
# Symlinks are resolved before the check, so a link inside the root that
# points outside it is refused too. On Windows symlinks are not resolved
# (only "..", drive letters and absolute paths are checked).
#
# Residual risk: the check and the file operation are two steps, so an
# attacker who can create symlinks inside the root concurrently could
# race them (TOCTOU). Do not put attacker-writable directories in a sandbox.

fn fs_sandbox(root):
    if type(root) != "string" or len(root) == 0:
        return nil
    let real = path_real(root, true)
    if real == nil:
        return nil
    return {"root": real}

# Returns the resolved absolute path inside the sandbox, or nil.
fn fs_sandbox_path(sb, rel):
    if sb == nil or type(rel) != "string" or len(rel) == 0:
        return nil
    let first = substring(rel, 0, 1)
    if first == "/" or first == "\\":
        return nil
    if len(rel) >= 2 and substring(rel, 1, 1) == ":":
        return nil
    if contains(rel, "\\"):
        return nil
    let full = path_real(sb["root"] + "/" + rel)
    if full == nil:
        return nil
    let root = sb["root"]
    if full == root:
        return full
    let prefix = root
    if substring(root, len(root) - 1, 1) != "/":
        prefix = root + "/"
    if len(full) > len(prefix) and substring(full, 0, len(prefix)) == prefix:
        return full
    return nil

fn fs_sandbox_read(sb, rel):
    let p = fs_sandbox_path(sb, rel)
    if p == nil:
        return nil
    return read_file(p)

fn fs_sandbox_write(sb, rel, content):
    let p = fs_sandbox_path(sb, rel)
    if p == nil:
        return nil
    return write_file_atomic(p, content)

fn fs_sandbox_append(sb, rel, content):
    let p = fs_sandbox_path(sb, rel)
    if p == nil:
        return nil
    return fs_append(p, content)

fn fs_sandbox_exists(sb, rel):
    let p = fs_sandbox_path(sb, rel)
    if p == nil:
        return false
    return file_exists(p)

fn fs_sandbox_remove(sb, rel):
    let p = fs_sandbox_path(sb, rel)
    if p == nil:
        return false
    return remove_file(p)
