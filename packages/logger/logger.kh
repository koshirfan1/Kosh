# Kosh logger package v1.1.0
# Author: Irfan Khan
# Structured logging with levels, file output, and formatting
#
# Usage:
#   import "logger"
#   let log = logger_new("MyApp")
#   log = log_info(log, "Server started")
#   log = log_warn(log, "High memory usage")
#   log = log_error(log, "Connection failed")
#   logger_save(log, "app.log")

# ─────────────────────────────────────────────────────────────
# LEVELS
# ─────────────────────────────────────────────────────────────

let LOG_DEBUG = 0
let LOG_INFO  = 1
let LOG_WARN  = 2
let LOG_ERROR = 3
let LOG_NONE  = 4

# SAFETY (v1.1.0)
#   - Newlines, carriage returns and ESC in a message or logger name are
#     escaped (\n, \r, \x1b), so user input cannot forge extra log lines
#     or inject terminal escape sequences.
#   - Secrets are redacted: in log_kv / log_map by key name, and in any
#     message by scanning for  password|passwd|secret|token|api_key|
#     apikey|authorization|bearer|cookie|private_key|access_key  followed
#     by = or : and a value (the value becomes [REDACTED]).
#     This is a best-effort safety net, NOT a guarantee: a secret that is
#     not labelled (a bare "sk-123" in text) cannot be detected. Do not log
#     secrets. Turn off with  log = logger_redact(log, false).

# ─────────────────────────────────────────────────────────────
# LOGGER
# ─────────────────────────────────────────────────────────────

fn logger_new(name):
    return {
        "name":    name,
        "entries": [],
        "level":   LOG_INFO,
        "silent":  false,
        "redact":  true
    }

fn logger_redact(log, on):
    log["redact"] = on
    return log

fn logger_set_level(log, level):
    log["level"] = level
    return log

fn logger_silent(log):
    log["silent"] = true
    return log

# ─────────────────────────────────────────────────────────────
# INTERNAL
# ─────────────────────────────────────────────────────────────

fn _log_level_str(level):
    if level == LOG_DEBUG:
        return "DEBUG"
    if level == LOG_INFO:
        return "INFO"
    if level == LOG_WARN:
        return "WARN"
    if level == LOG_ERROR:
        return "ERROR"
    return "???"

let _LOG_SENSITIVE = ["password", "passwd", "secret", "token", "api_key", "apikey", "api-key", "authorization", "bearer", "cookie", "private_key", "access_key", "credential"]

# Escape characters that could forge log lines or drive the terminal.
fn _log_clean(s):
    s = str(s)
    s = str_replace(s, "\\", "\\\\")
    s = str_replace(s, "\n", "\\n")
    s = str_replace(s, "\r", "\\r")
    s = str_replace(s, "\x1b", "\\x1b")
    return s

fn _log_is_sensitive_key(key):
    let k = lower(str(key))
    for w in _LOG_SENSITIVE:
        if contains(k, w):
            return true
    return false

fn _log_is_value_end(c):
    return c == " " or c == "\t" or c == "," or c == ";" or c == "&" or c == "\n" or c == "\r" or c == ")" or c == "]" or c == "}"

# Replace the value after "<sensitive word> = " / ": " / "bearer " with [REDACTED].
fn _log_redact_text(msg):
    let low = lower(msg)
    let n = len(msg)
    let out = ""
    let i = 0
    while i < n:
        let hit = ""
        for w in _LOG_SENSITIVE:
            if hit == "" and i + len(w) <= n and substring(low, i, len(w)) == w:
                hit = w
        if hit == "":
            out = out + substring(msg, i, 1)
            i = i + 1
        else:
            let j = i + len(hit)
            # let a word like api_key_id / password2 run on
            while j < n and not _log_is_value_end(substring(msg, j, 1)) and substring(msg, j, 1) != "=" and substring(msg, j, 1) != ":":
                j = j + 1
            let k = j
            while k < n and substring(msg, k, 1) == " ":
                k = k + 1
            let sep = ""
            if k < n:
                sep = substring(msg, k, 1)
            let is_bearer = (hit == "bearer")
            if sep == "=" or sep == ":" or (is_bearer and k > j):
                if sep == "=" or sep == ":":
                    k = k + 1
                    while k < n and substring(msg, k, 1) == " ":
                        k = k + 1
                # value: already redacted, quoted, or up to a delimiter
                let v_end = k
                let done = false
                if k + 10 <= n and substring(msg, k, 10) == "[REDACTED]":
                    v_end = k + 10
                    done = true
                if not done and k < n and (substring(msg, k, 1) == "\"" or substring(msg, k, 1) == "'"):
                    let q = substring(msg, k, 1)
                    v_end = k + 1
                    while v_end < n and substring(msg, v_end, 1) != q:
                        v_end = v_end + 1
                    if v_end < n:
                        v_end = v_end + 1
                    done = true
                if not done:
                    while v_end < n and not _log_is_value_end(substring(msg, v_end, 1)):
                        v_end = v_end + 1
                # "Authorization: Bearer xyz" / "Basic xyz": also eat the credential
                let word = lower(substring(msg, k, v_end - k))
                if (word == "bearer" or word == "basic") and v_end < n and substring(msg, v_end, 1) == " ":
                    v_end = v_end + 1
                    while v_end < n and not _log_is_value_end(substring(msg, v_end, 1)):
                        v_end = v_end + 1
                out = out + substring(msg, i, k - i) + "[REDACTED]"
                i = v_end
            else:
                out = out + substring(msg, i, j - i)
                i = j
    return out

fn _log_prepare(log, msg):
    let m = str(msg)
    if log["redact"]:
        m = _log_redact_text(m)
    return _log_clean(m)

fn _log_write(log, level, msg):
    if level < log["level"]:
        return log
    let clean = _log_prepare(log, msg)
    let entry = {
        "level":   level,
        "label":   _log_level_str(level),
        "message": clean,
        "time":    clock(),
        "source":  _log_clean(log["name"])
    }
    log["entries"] = push(log["entries"], entry)
    if log["silent"] == false:
        print "[" + entry["source"] + "] [" + entry["label"] + "] " + clean
    return log

# ─────────────────────────────────────────────────────────────
# LOG FUNCTIONS
# ─────────────────────────────────────────────────────────────

fn log_debug(log, msg):
    return _log_write(log, LOG_DEBUG, msg)
fn log_info(log, msg):
    return _log_write(log, LOG_INFO,  msg)
fn log_warn(log, msg):
    return _log_write(log, LOG_WARN,  msg)
fn log_error(log, msg):
    return _log_write(log, LOG_ERROR, msg)

fn log_divider(log):
    return log_info(log, "────────────────────────────────────────")

fn log_kv(log, key, value):
    if log["redact"] and _log_is_sensitive_key(key):
        return log_info(log, str(key) + " = [REDACTED]")
    return log_info(log, str(key) + " = " + str(value))

fn log_map(log, label, m):
    log = log_info(log, label + ":")
    for k in keys(m):
        if log["redact"] and _log_is_sensitive_key(k):
            log = log_info(log, "  " + str(k) + ": [REDACTED]")
        else:
            log = log_info(log, "  " + str(k) + ": " + str(m[k]))
    return log

# ─────────────────────────────────────────────────────────────
# QUERY
# ─────────────────────────────────────────────────────────────

fn logger_errors(log):
    let result = []
    for e in log["entries"]:
        if e["level"] >= LOG_ERROR:
            result = push(result, e)
    return result

fn logger_warnings(log):
    let result = []
    for e in log["entries"]:
        if e["level"] == LOG_WARN:
            result = push(result, e)
    return result

fn logger_has_errors(log):
    return len(logger_errors(log)) > 0

fn logger_count(log):
    return len(log["entries"])

# ─────────────────────────────────────────────────────────────
# OUTPUT
# ─────────────────────────────────────────────────────────────

fn logger_to_string(log):
    let out = ""
    for e in log["entries"]:
        out = out + "[" + e["source"] + "] [" + e["label"] + "] " + e["message"] + "\n"
    return out

fn logger_save(log, path):
    return write_file_atomic(path, logger_to_string(log))

fn logger_summary(log):
    let errors = len(logger_errors(log))
    let warns  = len(logger_warnings(log))
    print "── Logger summary: " + log["name"] + " ──"
    print "  Total entries : " + str(len(log["entries"]))
    print "  Warnings      : " + str(warns)
    print "  Errors        : " + str(errors)
