# Kosh FTP Package
# Usage: import "ftp"
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  STATUS: EXPERIMENTAL — NOT IMPLEMENTED                                  │
# │  No FTP protocol code exists yet.                                        │
# │  Every function below reports failure instead of pretending to work.     │
# └──────────────────────────────────────────────────────────────────────────┘
#
# (Before version 1.0.1 these functions printed a line and returned success, so
# a program would believe a file had been transferred when nothing had happened.)
#

fn ftp_is_implemented():
    return false

fn _ftp_not_implemented(what):
    print "[ftp] NOT IMPLEMENTED: " + what + " did nothing. This package is a placeholder; no FTP code exists yet, so no file was transferred."
    return false

# Creates the client description only; it never connects.
fn ftp_client(host, user, pass):
    return {
        "host": host,
        "user": user,
        "pass": pass,
        "implemented": false
    }

# Always returns false: nothing is uploaded.
fn ftp_upload(client, local_path, remote_path):
    return _ftp_not_implemented("ftp_upload()")

# Always returns false: nothing is downloaded.
fn ftp_download(client, remote_path, local_path):
    return _ftp_not_implemented("ftp_download()")
