# Test for dotenv package
import "../packages/dotenv/dotenv.kh"
import "../packages/test/test.kh"

let t = test_suite("Dotenv Suite")

# Create a test .env file
let env_content = "PORT=8080\n# comment\nHOST=\"localhost\"\nSECRET='abc-123'\n\nDEBUG=true"
write_file("test.env", env_content)

let my_env = load_env("test.env")
t = test_eq(t, "PORT should be 8080", env_get(my_env, "PORT"), "8080")
t = test_eq(t, "HOST should be localhost", env_get(my_env, "HOST"), "localhost")
t = test_eq(t, "SECRET should be abc-123", env_get(my_env, "SECRET"), "abc-123")
t = test_eq(t, "DEBUG should be true", env_get(my_env, "DEBUG"), "true")
t = test_nil(t, "Unknown key should be nil", env_get(my_env, "UNKNOWN"))


# ---- Phase B hardening ------------------------------------------------
write_file("tests/_h.env", "API_KEY=abc123==\nURL=postgres://h/db?sslmode=require&x=1\nexport TOKEN=xyz\nQ=\"a b\" # note\nR='lit\\n' \nS=plain # c\nT=\"x\\ny\"\nbadline\n=nokey\nH=a#b\nE=\nDUP=1\nDUP=2\n")
let h = load_env("tests/_h.env")
t = test_eq(t, "value with == is kept whole", env_get(h, "API_KEY"), "abc123==")
t = test_eq(t, "URL with = in query is kept", env_get(h, "URL"), "postgres://h/db?sslmode=require&x=1")
t = test_eq(t, "export prefix ignored", env_get(h, "TOKEN"), "xyz")
t = test_nil(t, "no 'export TOKEN' key", env_get(h, "export TOKEN"))
t = test_eq(t, "inline comment after quotes", env_get(h, "Q"), "a b")
t = test_eq(t, "single quotes are literal", env_get(h, "R"), "lit\\n")
t = test_eq(t, "inline comment on bare value", env_get(h, "S"), "plain")
t = test_eq(t, "double-quote \\n escape", env_get(h, "T"), "x\ny")
t = test_eq(t, "# inside a word is not a comment", env_get(h, "H"), "a#b")
t = test_eq(t, "empty value is empty string", env_get(h, "E"), "")
t = test_eq(t, "later duplicate wins", env_get(h, "DUP"), "2")
t = test_nil(t, "line without = skipped", env_get(h, "badline"))
t = test_eq(t, "empty key and no-= lines skipped (10 keys kept)", len(keys(h)), 10)
# (the chmod 600 / 644 behaviour of load_env_strict is tested in tests/security/test_packages.py)
t = test_eq(t, "strict on a missing file is empty", len(keys(load_env_strict("tests/_nope.env"))), 0)
remove_file("tests/_h.env")

test_run(t)
