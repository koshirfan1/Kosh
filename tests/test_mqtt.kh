# mqtt is an EXPERIMENTAL placeholder: no MQTT code exists.
import "../packages/mqtt/mqtt.kh"
import "../packages/test/test.kh"

let t = test_suite("MQTT (experimental placeholder)")
let client = mqtt_client("broker.hivemq.com", 1883)
t = test_eq(t, "host kept", client["host"], "broker.hivemq.com")
t = test_false(t, "mqtt_is_implemented() is false", mqtt_is_implemented())
t = test_false(t, "mqtt_subscribe reports FAILURE (and does not return a client that looks subscribed)", mqtt_subscribe(client, "kosh/test"))
t = test_false(t, "mqtt_publish reports FAILURE, not success", mqtt_publish(client, "kosh/test", "Hello IoT"))
test_run(t)
