# webi_socket is an EXPERIMENTAL placeholder: no WebSocket support exists.
# ws_route() is an ordinary GET route; ws_send/ws_broadcast report failure.
import "../packages/webi_socket/webi_socket.kh"
import "../packages/test/test.kh"

let t = test_suite("Webi Socket (experimental placeholder)")

fn chat_handler(req):
    return res_text("plain http, not a websocket")

let app = webi_app()
app = ws_route(app, "/chat", chat_handler)

let routes = webi_routes(app)
let found = false
for r in routes:
    if r == "GET /chat":
        found = true
t = test_true(t, "ws_route still registers a plain GET route", found)
t = test_false(t, "ws_is_implemented() is false", ws_is_implemented())
t = test_false(t, "ws_send reports FAILURE, not success", ws_send("client1", "hello"))
t = test_false(t, "ws_broadcast reports FAILURE, not success", ws_broadcast("hello"))
test_run(t)
