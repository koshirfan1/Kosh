# ssh_client is an EXPERIMENTAL placeholder: no SSH code exists.
import "../packages/ssh_client/ssh_client.kh"
import "../packages/test/test.kh"

let t = test_suite("SSH (experimental placeholder)")
let client = ssh_client("server.com", "root", "secret")
t = test_false(t, "ssh_is_implemented() is false", ssh_is_implemented())
t = test_nil(t, "ssh_exec returns nil: no output is invented", ssh_exec(client, "ls -la"))
test_run(t)
